def strip_markup(text: str) -> str:
    """Remove spans/tags and the tooltip frame, preserving the bars."""
    text = re.sub(r"<[^>]+>", "", text)
    for ch in "╭╮╰╯":
        text = text.replace(ch, "")
    text = text.replace("│", " ")
    text = re.sub(r"─{2,}", "", text)
    # icon glyphs (nerd fonts / PUA) and clock
    text = re.sub(r"[-\U000f0000-\U000fffff⏱]", "", text)
    lines = []
    for line in text.splitlines():
        line = " ".join(line.split()).strip()
        if line:
            lines.append(line)
    return "\n".join(lines)


def parse_tooltip(tooltip: str, vendor_label: str):
    """Extract plan, meters (name, %, trend, reset), extras and timestamp."""
    lines = strip_markup(tooltip).splitlines()
    info = {'plan': '', 'meters': [], 'extras': [], 'updated': ''}
    if lines:
        title = lines[0]
        info['plan'] = title[len(vendor_label):].strip() if title.startswith(vendor_label) else title

    prev_label = ''
    for line in lines[1:]:
        m_up = re.search(r"Updated\s+(\S+)", line)
        if m_up:
            info['updated'] = m_up.group(1)
            continue
        m_reset = re.search(r"Resets in\s+(.+)", line)
        if m_reset:
            if info['meters']:
                info['meters'][-1]['reset'] = m_reset.group(1).strip()
            continue
        is_bar = '%' in line and ('█' in line or '░' in line)
        if is_bar:
            m_pct = re.search(r"(\d+)%", line)
            if m_pct:
                info['meters'].append({
                    'name': prev_label or f'Usage {len(info["meters"]) + 1}',
                    'pct': int(m_pct.group(1)),
                    'trend': '↓' if '↓' in line else ('↑' if '↑' in line else ''),
                    'reset': '',
                })
            prev_label = ''
            continue
        if '█' in line or '░' in line:
            continue
        prev_label = line

    # stray lines (credits etc.) become the footer; the pending label goes along
    for line in lines[1:]:
        if re.search(r"balance:|messages", line):
            if 'Credits' not in info['extras'] and any('Credits' in l for l in lines):
                info['extras'].append('Credits')
            info['extras'].append(line)
    return info


# OpenRouter reports money, not time windows: "$0.14 of $10.00 used (1%)" for the balance and
# "$49.86 of $50.00 remaining" for the per-key cap. Note the two phrasings mean opposite things,
# and that the amount may be negative on an overdrawn account.
OPENROUTER_MONEY = re.compile(r'\$(-?[\d,.]+)\s+of\s+\$(-?[\d,.]+)\s+(used|remaining)')


API_KEY_FRAGMENT = re.compile(r'\bsk-[A-Za-z0-9._-]{2,}')
TIER_WORD = re.compile(r'\btier\b', re.IGNORECASE)


def redact_keys(text):
    """Blank out anything shaped like an API key before it can reach the screen.

    Skipping the tooltip's first line is a POSITIONAL guard: it holds only while the vendor keeps
    the key on that exact line. This is the guard by content, so one extra line from the binary
    cannot put the key back on a card.
    """
    return API_KEY_FRAGMENT.sub('sk-…', text)


def openrouter_tier(tooltip):
    """The plan pill for OpenRouter: the tier line, never the tooltip title.

    The title is "OpenRouter — sk-or-v1-...", so reading it — which is what parse_tooltip() does
    for every other vendor — would print a fragment of the API key on the card.
    """
    for line in strip_markup(tooltip).splitlines()[1:]:
        # whole word: "frontier models" is OpenRouter's own vocabulary and must not pass as a tier
        if TIER_WORD.search(line):
            return redact_keys(line.strip())
    return ''


def openrouter_blank(tooltip):
    """Info with no meters, for when the tooltip cannot be parsed.

    It exists so the card never falls back to parse_tooltip() for this vendor: that fallback
    would put the key fragment back in the plan pill.
    """
    return {'plan': openrouter_tier(tooltip), 'meters': [], 'extras': [], 'updated': ''}


def openrouter_info(tooltip):
    """Build the card info for OpenRouter, which has balances instead of windows that reset.

    Returns None when the tooltip carries no usable money line, so the caller can degrade to
    openrouter_blank() — losing detail is fine, inventing a number is not.
    """
    lines = strip_markup(tooltip).splitlines()
    rows, extras, updated, pending = [], [], '', ''

    # lines[0] is "OpenRouter — sk-or-v1-...", which carries a fragment of the API key: never read it
    for line in lines[1:]:
        m_updated = re.search(r'Updated\s+(\S+)', line)
        if m_updated:
            updated = redact_keys(m_updated.group(1))
            continue
        if TIER_WORD.search(line):
            continue
        m_money = OPENROUTER_MONEY.search(line)
        if m_money:
            # per line, so one unreadable figure costs its own meter and not the whole card:
            # aborting the function would throw away the meters that parsed perfectly well
            try:
                total = float(m_money.group(2).replace(',', ''))
                amount = float(m_money.group(1).replace(',', ''))
            except ValueError:
                print(f'openrouter: unreadable money line: {line.strip()!r}', file=sys.stderr)
                pending = ''
                continue
            if total <= 0:
                pending = ''
                continue
            # "used" gives what was spent; "remaining" gives the opposite — reading one as the
            # other turns an untouched key into a nearly full red gauge
            used = amount if m_money.group(3) == 'used' else total - amount
            rows.append({
                'name': redact_keys(pending) or f'Usage {len(rows) + 1}',
                # from the dollars, not from the "(1%)" the tooltip rounds off. A credit can push
                # `used` below zero; a gauge cannot go backwards, so the bar floors at empty while
                # the note keeps the real figure.
                'pct': max(0.0, used / total * 100),
                'trend': '',
                'reset': '',
                'note': f'${total - used:,.2f} left',
            })
            pending = ''
            continue
        if re.search(r'today .*week .*month', line):
            extras.append(redact_keys(line.strip()))
            pending = ''
            continue
        if '█' in line or '░' in line:   # the bar sits between the label and its figures
            continue
        pending = line.strip()

    if not rows:
        return None
    # Most spent first, so the hero is the limit that actually binds — NOT the smallest pot, which
    # is a different thing: a $10 balance at 1% next to a $50 cap at 96% would headline the green
    # one and hide the limit about to block every request.
    rows.sort(key=lambda meter: meter['pct'], reverse=True)
    return {'plan': openrouter_tier(tooltip), 'meters': rows,
            'extras': extras, 'updated': updated}


def fmt_pct(value):
    """Percentage for display: one decimal below 10%, integer from there up.

    Below 10% the decimal place is informative — 0.4% and 2.2% would both become "2%" if rounded.
    Above that it just adds noise, and the other vendors have always shown an integer.
    """
    # round BEFORE deciding: 9.96 becomes "10.0" with one decimal, breaking the rule itself
    rounded = round(value, 1)
    if rounded >= 10 or rounded == int(rounded):
        return str(int(round(value)))
    return f'{rounded:.1f}'


def fmt_delta(ms_epoch):
    """Time left until `ms_epoch` (milliseconds), in the same style as the other cards: `2d 17h`, `4h 31m`."""
    if not isinstance(ms_epoch, (int, float)) or isinstance(ms_epoch, bool):
        return '—'
    secs = int(ms_epoch / 1000 - time.time())
    if secs <= 0:
        return 'now'
    days, rest = divmod(secs, 86400)
    hours, rest = divmod(rest, 3600)
    minutes = rest // 60
    if days:
        return f'{days}d {hours}h'
    if hours:
        return f'{hours}h {minutes}m'
    return f'{minutes}m'


def fmt_countdown(seconds):
    """Time until the next automatic refresh, as `next in M:SS`.

    Ceil, not floor or round: the window opens reading 5:00, and the refresh fires when the count
    reaches zero. Flooring would show 0:00 for a whole second while the read is already late.
    No hour unit on purpose — the interval is minutes, and 60:00 is honest where 1:00:00 would
    invent a precision the header has no room for.
    """
    total = max(0, math.ceil(seconds))
    minutes, secs = divmod(total, 60)
    return f'next in {minutes}:{secs:02d}'


def fmt_meter_line(meter):
    """One strip line: `Name · NN% · tail`. The tail is the meter's `note` when it has one — money
    meters carry the dollars there and leave `reset` empty — else a usable `reset`. Absent pieces
    are skipped, never rendered as None."""
    parts = [meter.get('name') or '']
    pct = meter.get('pct')
    if isinstance(pct, (int, float)) and not isinstance(pct, bool):
        parts.append(f'{int(round(pct))}%')
    tail = meter.get('note') or meter.get('reset')
    if tail and tail != '—':
        parts.append(str(tail))
    return ' · '.join(p for p in parts if p)


def pick_strip_meters(info):
    """(window, weekly) for a strip block. `window` is the first meter; `weekly` is the first meter
    named like a week (never "Fable weekly"), else — and only for OpenRouter's money pair, in either
    order, since the parser sorts by pct — the other of Balance/Per-key limit. Anything else has no
    third line. Missing or empty meters degrade to (None, None) without raising."""
    meters = (info or {}).get('meters') or []
    if not meters:
        return (None, None)
    window = meters[0]
    weekly = next((m for m in meters
                   if 'week' in (m.get('name') or '').lower()
                   and 'fable' not in (m.get('name') or '').lower()), None)
    if weekly is None and len(meters) > 1:
        if {meters[0].get('name'), meters[1].get('name')} == {'Balance', 'Per-key limit'}:
            weekly = meters[1]
    return (window, weekly)


def zai_api_key():
    """Z.AI key: ai-usagebar's config.toml first, the env afterwards.

    Same source ai-usagebar uses — no third place to keep updated. The config.toml serves the
    popup launched from the .desktop file, which doesn't see what .bashrc exports.
    """
    try:
        with ZAI_CONFIG.open('rb') as fh:
            section = tomllib.load(fh).get('zai')
        # `zai = "key"` instead of `[zai]` is a plausible typo: it can't turn into an exception
        key = section.get('api_key', '') if isinstance(section, dict) else ''
        if key:
            return key
    except (OSError, tomllib.TOMLDecodeError):
        pass
    return os.environ.get('ZAI_API_KEY', '')


def zai_window_label(limit):
    """Meter label from unit/number.

    An unknown unit returns a degraded label instead of disappearing: a new plan changing `unit`
    can't turn into a silently empty card.
    """
    unit = limit.get('unit')
    number = limit.get('number', 0)
    if unit in ZAI_UNITS:
        _, plural, singular = ZAI_UNITS[unit]
        return singular if number == 1 else plural.format(n=number)
    return f'Window {number}·u{unit}'


def zai_window_seconds(limit):
    """Window duration in seconds — the sort key.

    An unknown unit goes to the end instead of competing for the hero number with a made-up duration.
    """
    unit = limit.get('unit')
    number = limit.get('number', 0)
    if unit in ZAI_UNITS and isinstance(number, (int, float)):
        return ZAI_UNITS[unit][0] * number
    return float('inf')


def zai_error(reason):
    """Single error contract for Z.AI — the same for all five failure classes.

    `text` is what is_bad() recognizes, so no failure turns into a card with a fake number; `reason`
    and `fix` are read by offline_reason() for the "not configured" line.
    """
    return {'text': 'unavailable', 'tooltip': reason, 'class': 'critical',
            'reason': reason, 'fix': '[zai] api_key'}


def zai_info(payload):
    """Translate the Z.AI API response into the format parse_tooltip() produces. Pure function."""
    if not isinstance(payload, dict):
        raise ValueError('response is not a JSON object')
    if not payload.get('success'):
        raise ValueError(f"API refused: {payload.get('msg') or 'no reason given'}")
    # every check comes BEFORE the access it protects: validating after using protects nothing
    data = payload.get('data') or {}
    if not isinstance(data, dict):
        raise ValueError('response has no usage windows')
    limits = data.get('limits') or []
    if not isinstance(limits, list) or not limits:
        raise ValueError('response has no usage windows')
    # before the sorted(): the sort key already accesses each window
    if not all(isinstance(limit, dict) for limit in limits):
        raise ValueError('malformed usage window')

    meters, credits = [], []
    # sorts by window DURATION, not by reset time — see the comment on ZAI_UNITS
    for limit in sorted(limits, key=zai_window_seconds):
        used, total = limit.get('currentValue'), limit.get('usage')
        # a missing field must NOT become 0% green: that's exactly the fake number the card can't show
        if used is None or total is None:
            raise ValueError('response is missing usage fields')
        used, total = float(used), float(total)
        if total <= 0:
            raise ValueError('invalid window limit')
        label = zai_window_label(limit)
        meters.append({'name': label, 'pct': used / total * 100, 'trend': '',
                       'reset': fmt_delta(limit.get('nextResetTime'))})
        credits.append(f'{used:.0f}/{total:.0f} ({label.lower()})')

    level = data.get('level') or ''
    return {'plan': f'GLM Coding {level.capitalize()}' if level else '',
            'meters': meters,
            'extras': [f"credits {' · '.join(credits)}"] if credits else [],
            # empty on purpose: the global subtitle shows "the last non-empty one", and stamping the
            # local clock here would make another vendor's stale cache look just-read
            'updated': ''}


def run_zai():
    """Reads Z.AI usage directly from the API, bypassing ai-usagebar."""
    key = zai_api_key()
    if not key:
        return zai_error('no API key')

    req = urllib.request.Request(ZAI_URL, headers={'Authorization': f'Bearer {key}'})
    try:
        with urllib.request.urlopen(req, timeout=ZAI_TIMEOUT) as resp:
            body = resp.read()
    except urllib.error.HTTPError as e:          # subclass of URLError: comes first
        return zai_error(f'HTTP {e.code}')
    except TimeoutError:
        return zai_error(f'timed out ({ZAI_TIMEOUT}s)')
    except urllib.error.URLError as e:
        reason = getattr(e, 'reason', '')
        if isinstance(reason, TimeoutError) or 'timed out' in str(reason).lower():
            return zai_error(f'timed out ({ZAI_TIMEOUT}s)')
        return zai_error('network unavailable')    # DNS, connection refused: different diagnosis
    except OSError:
        return zai_error('network unavailable')

    try:
        payload = json.loads(body)
    except (ValueError, UnicodeDecodeError):
        return zai_error('response is not JSON')

    try:
        info = zai_info(payload)
    except ValueError as e:
        return zai_error(str(e))

    first = info['meters'][0]
    return {'text': f"{fmt_pct(first['pct'])}%", 'tooltip': '',
            'class': klass_of(first['pct']), 'info': info}


def vendor_entries():
    """(vendor_arg, card label) for every card, one per extra Anthropic account.

    Each `[[anthropic.accounts]]` entry in ai-usagebar's config.toml becomes its own Claude card,
    queried with `--account <label>`. An entry whose credentials file IS the default account's
    (`~/.claude/.credentials.json`) is skipped: it would render the same data twice, once labeled
    "Claude" and once labeled "Claude · <label>" — that's a duplicate card, not a second account.
    Malformed entries are skipped, not fatal — a broken account line can't take the other cards
    down with it. Re-read on every refresh, so adding an account to the config shows up on ↻ Refresh.
    """
    try:
        with USAGEBAR_CONFIG.open('rb') as fh:
            section = tomllib.load(fh).get('anthropic')
        accounts = section.get('accounts') if isinstance(section, dict) else None
    except (OSError, tomllib.TOMLDecodeError):
        accounts = None
    default_creds = (Path.home() / '.claude/.credentials.json').resolve()
    extra = []
    for acc in accounts or []:
        if not (isinstance(acc, dict) and isinstance(acc.get('label'), str) and acc['label']):
            continue
        creds = acc.get('credentials_path')
        if isinstance(creds, str) and creds and Path(creds).expanduser().resolve() == default_creds:
            continue
        extra.append((f'anthropic@{acc["label"]}', f'Claude · {acc["label"]}'))
    return list(VENDORS) + extra


def run_qwen():
    """Reads Qwen (Bailian Token Plan) usage through the `bl` CLI."""
    try:
        out = subprocess.check_output(['bl', 'usage', 'token-plan', '--output', 'json'],
                                      text=True, stderr=subprocess.DEVNULL,
                                      timeout=QWEN_TIMEOUT,
                                      env=qwen_env())
    except FileNotFoundError:
        return qwen_error('bl CLI not found (npm i -g bailian-cli)')
    except subprocess.TimeoutExpired:
        return qwen_error(f'timed out ({QWEN_TIMEOUT}s)')
    except subprocess.CalledProcessError as e:
        return qwen_error(f'bl exited {e.returncode} — run `bl auth login --console`')
    except OSError as e:
        return qwen_error(f'cannot run bl: {e}')

    try:
        payload = json.loads(out)
    except (ValueError, UnicodeDecodeError):
        return qwen_error('bl response is not JSON')

    # A failed call comes back as an error body with exit code 0 (seen 2026-10-22: an expired
    # console session), so the CalledProcessError branch never fires and the card would report
    # the generic "no usage" instead of the reason bl actually gave.
    error = payload.get('error') if isinstance(payload, dict) else None
    if isinstance(error, dict):
        reason = error.get('message') or error.get('hint') or 'bl reported an error'
        return qwen_error(str(reason).strip())

    # `bl` wraps the numbers somewhere under `data`; instead of chasing its nesting, look for the
    # keys this report carries wherever they are.
    def find(node, key):
        if isinstance(node, dict):
            if isinstance(node.get(key), (int, float)) and not isinstance(node.get(key), bool):
                return node[key]
            for value in node.values():
                found = find(value, key)
                if found is not None:
                    return found
        elif isinstance(node, list):
            for value in node:
                found = find(value, key)
                if found is not None:
                    return found
        return None

    pct = find(payload, 'per1MonthPercentage')
    if pct is None:
        return qwen_error('bl reported no usage — run `bl auth login --console`')
    # Confirmed against the real API on 2026-10-20: 1.25% used arrives as 0.01246 — a fraction,
    # not the 0–100 the other cards speak. A true "100%" can only arrive as 1.0 under this
    # reading, so scaling <=1 up is safe in both worlds.
    if pct <= 1:
        pct *= 100
    return {'text': f'{fmt_pct(pct)}%', 'tooltip': '', 'class': klass_of(pct),
            'info': {'plan': 'Token Plan',
                     'meters': [{'name': 'Monthly', 'pct': pct, 'trend': '',
                                 'reset': fmt_delta(find(payload, 'per1MonthResetTime'))}],
                     'extras': ['monthly limit may be unlimited — see the Bailian console'],
                     'updated': ''}}


def qwen_env():
    """PATH with nvm's bin dirs prepended: the desktop launcher doesn't inherit .bashrc, so `bl`
    and `node` (both installed under nvm) are invisible without this."""
    env = dict(os.environ)
    extras = [str(d) for d in sorted(Path.home().glob('.nvm/versions/node/*/bin'))]
    if extras:
        env['PATH'] = ':'.join(extras) + ':' + env.get('PATH', '')
    return env


def qwen_error(reason):
    """Single error contract for Qwen — same shape as zai_error, the fix names the one-time login."""
    return {'text': 'unavailable', 'tooltip': reason, 'class': 'critical',
            'reason': reason, 'fix': 'bl auth login --console'}


def run_vendor(spec: str):
    if spec == 'zai':
        # The generic guard is mandatory here: this detour happens OUTSIDE the try below, and an
        # exception escaping kills the pool thread — GLib.idle_add(render) never runs and the whole
        # popup freezes on "updating…", taking the other five vendors down with it.
        try:
            return run_zai()
        except Exception as e:
            return zai_error(f'unexpected failure: {type(e).__name__}')
    if spec == 'qwen':
        try:
            return run_qwen()
        except Exception as e:
            return qwen_error(f'unexpected failure: {type(e).__name__}')
    try:
        # `anthropic@<label>` selects a named account from [[anthropic.accounts]]; the plain
        # vendor keeps the default account and unchanged output.
        vendor, _, account = spec.partition('@')
        args = [AI, '--vendor', vendor, '--json']
        if account:
            args += ['--account', account]
        out = subprocess.check_output(args, text=True, stderr=subprocess.DEVNULL, timeout=20)
        data = json.loads(out)
        result = {
            'text': strip_markup(str(data.get('text', ''))),
            'tooltip': str(data.get('tooltip', '')),
            'class': data.get('class', '?'),
        }
        if vendor == 'openrouter':
            # A parser failure here must cost detail, not the vendor: without the guard the
            # exception would reach the except below and report a working account as unavailable.
            # `info` is attached even when empty, ON PURPOSE: letting make_card fall back to
            # parse_tooltip() would read the tooltip title — and the API key fragment in it — as
            # the plan pill, which is exactly what this vendor's card must never show.
            # openrouter_blank() is inside the guard too: it re-reads the same tooltip, so
            # whatever broke the parser can break it as well, and the outer except would then
            # report a working account as unavailable.
            try:
                result['info'] = openrouter_info(result['tooltip']) or \
                    openrouter_blank(result['tooltip'])
            except Exception as e:
                # say it out loud: the silent symptom is the card quietly losing its gauges
                print(f'openrouter: could not read the tooltip ({type(e).__name__}: {e})',
                      file=sys.stderr)
                result['info'] = {'plan': '', 'meters': [], 'extras': [], 'updated': ''}
        return result
    except Exception as e:
        return {'text': 'unavailable', 'tooltip': str(e), 'class': 'critical'}


def is_bad(data):
    txt = (data.get('text') or '').lower()
    tip = strip_markup(data.get('tooltip') or '').lower()
    return ('no api key' in tip or 'no usable cache' in tip or 'credentials error' in tip
            or txt in ('⚠', 'unavailable'))


def offline_reason(vendor, data):
    # A vendor read straight from the API already brings reason and fix ready to use (zai_error's
    # contract). Without this branch, a timeout would fall into the generic `config.toml` fallback
    # with the raw error text.
    if data.get('reason'):
        return data['reason'], data.get('fix') or 'config.toml'
    tip = strip_markup(data.get('tooltip') or '').lower()
    if 'no usable cache' in tip:
        return 'no cache yet — run the vendor once to fill it', f'ai-usagebar --vendor {vendor}'
    if 'no api key' in tip or 'credentials error' in tip:
        return 'no API key', f'[{vendor}] api_key'
    first = strip_markup(data.get('tooltip') or data.get('text') or 'unavailable').splitlines()
    # This renders the tooltip's FIRST line, which for OpenRouter is "OpenRouter — sk-or-v1-…".
    # make_card was hardened against that; this is the sibling renderer, and it reaches the screen
    # through the "not configured" row.
    return redact_keys(first[0] if first else 'unavailable'), 'config.toml'


def esc(text):
    return GLib.markup_escape_text(str(text))


def card_order_path():
    config = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config')
    return config / 'ai-usage-popup' / 'card-order.json'


def load_card_order():
    try:
        saved = json.loads(card_order_path().read_text(encoding='utf-8'))
        if not isinstance(saved, list) or not all(isinstance(v, str) for v in saved):
            saved = []
    except (OSError, ValueError):
        saved = []
    # Retain extra accounts even when temporarily unavailable; append new vendors.
    return list(dict.fromkeys(saved + [vendor for vendor, _ in VENDORS]))


def save_card_order(order):
    path = card_order_path()
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        # Replace atomically so an interrupted write cannot truncate the preference.
        with tempfile.TemporaryDirectory(prefix='.card-order-', dir=path.parent) as tmp:
            staged = Path(tmp) / 'order.json'
            staged.write_text(json.dumps(order) + '\n', encoding='utf-8')
            staged.replace(path)
    except OSError as error:
        print(f'Could not save card order: {error}', file=sys.stderr)


def mode_path():
    config = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config')
    return config / 'ai-usage-popup' / 'mode.json'


def load_mode():
    try:
        saved = json.loads(mode_path().read_text(encoding='utf-8'))
        mode = saved.get('mode') if isinstance(saved, dict) else None
    except (OSError, ValueError):
        mode = None
    if mode == 'strip':   # legacy value from the pre-toolbar prototype
        mode = 'toolbar'
    # Anything but the two known modes is treated as the default, so a hand-edited or half-written
    # file can never strand the popup in a state it cannot render.
    return mode if mode in ('cards', 'toolbar') else 'cards'


def save_mode(mode):
    path = mode_path()
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory(prefix='.mode-', dir=path.parent) as tmp:
            staged = Path(tmp) / 'mode.json'
            staged.write_text(json.dumps({'mode': mode}) + '\n', encoding='utf-8')
            staged.replace(path)
    except OSError as error:
        print(f'Could not save mode: {error}', file=sys.stderr)


def bottom_strut(root_height, x, width, bottom, height):
    """_NET_WM_STRUT_PARTIAL that reserves `height` px above `bottom` across [x, x+width). The
    bottom value counts from the edge of the whole root window, not of the monitor."""
    return [0, 0, 0, root_height - bottom + height, 0, 0, 0, 0, 0, 0, x, x + width - 1]


_XA_CARDINAL = 6


def _xlib():
    """libX11 through ctypes: GTK3 has no API for struts, and this avoids a new dependency."""
    name = ctypes.util.find_library('X11')
    if not name:
        return None
    x = ctypes.CDLL(name)
    vp, ul = ctypes.c_void_p, ctypes.c_ulong
    x.XOpenDisplay.restype = vp
    x.XOpenDisplay.argtypes = [ctypes.c_char_p]
    x.XInternAtom.restype = ul
    x.XInternAtom.argtypes = [vp, ctypes.c_char_p, ctypes.c_int]
    x.XChangeProperty.argtypes = [vp, ul, ul, ul, ctypes.c_int, ctypes.c_int, vp, ctypes.c_int]
    x.XGetWindowProperty.argtypes = [vp, ul, ul, ctypes.c_long, ctypes.c_long, ctypes.c_int, ul,
                                     ctypes.POINTER(ul), ctypes.POINTER(ctypes.c_int),
                                     ctypes.POINTER(ul), ctypes.POINTER(ul), ctypes.POINTER(vp)]
    x.XFree.argtypes = [vp]
    x.XFlush.argtypes = [vp]
    x.XCloseDisplay.argtypes = [vp]
    return x


def _x11_target(gdk_window):
    """(xlib, display, xid) for an X11 GdkWindow, else None — a native Wayland window has no
    struts to set."""
    if gdk_window is None or GdkX11 is None or not isinstance(gdk_window, GdkX11.X11Window):
        return None
    x = _xlib()
    if x is None:
        return None
    display = x.XOpenDisplay(gdk_window.get_display().get_name().encode())
    if not display:
        return None
    return x, display, gdk_window.get_xid()


def write_strut(gdk_window, values):
    target = _x11_target(gdk_window)
    if target is None:
        return
    x, display, xid = target
    try:
        data = (ctypes.c_long * 12)(*values)
        partial = x.XInternAtom(display, b'_NET_WM_STRUT_PARTIAL', 0)
        x.XChangeProperty(display, xid, partial, _XA_CARDINAL, 32, 0, data, 12)
        legacy = x.XInternAtom(display, b'_NET_WM_STRUT', 0)
        x.XChangeProperty(display, xid, legacy, _XA_CARDINAL, 32, 0, data, 4)
        x.XFlush(display)
    finally:
        x.XCloseDisplay(display)


def read_strut(gdk_window):
    """The window's _NET_WM_STRUT_PARTIAL as a list, or None when it has none."""
    target = _x11_target(gdk_window)
    if target is None:
        return None
    x, display, xid = target
    try:
        atom = x.XInternAtom(display, b'_NET_WM_STRUT_PARTIAL', 0)
        kind, fmt = ctypes.c_ulong(), ctypes.c_int()
        count, after, prop = ctypes.c_ulong(), ctypes.c_ulong(), ctypes.c_void_p()
        x.XGetWindowProperty(display, xid, atom, 0, 12, 0, _XA_CARDINAL, ctypes.byref(kind),
                             ctypes.byref(fmt), ctypes.byref(count), ctypes.byref(after),
                             ctypes.byref(prop))
        if not prop.value:
            return None
        try:
            return list(ctypes.cast(prop, ctypes.POINTER(ctypes.c_long))[:count.value]) or None
        finally:
            x.XFree(prop)
    finally:
        x.XCloseDisplay(display)


class UsageWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title='AI Usage')
        # 940x640 cut the third row of cards; four rows of cards + header + "not configured" want
        # ~1400. Clamp to the actual screen so a laptop display gets a maximized-feeling window
        # instead of one taller than the monitor. The strip mode is short, so the height is applied
        # later, once the mode is known (see _apply_size).
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name('ai-usage-popup')
        self.get_style_context().add_class('ai-window')

        Gtk.Settings.get_default().set_property('gtk-application-prefer-dark-theme', True)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.card_order = load_card_order()
        self.auto_refresh = AUTO_REFRESH_SECONDS
        self._next_refresh = None
        self._refreshing = False
        self._subtitle_base = ''
        # The cache must exist before the header is built: the mode button can be clicked while the
        # first (asynchronous) collection is still in flight.
        self._last_results = None
        self.mode = load_mode()
        self._build_header()
        self._apply_presentation()
        # Every toggle unrealizes the window, so each realize is a new X window: the toolbar's
        # reserves its strip there, and a cards window simply never gets one.
        self.connect_after('realize', lambda _w: self._reserve_strip())

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.add(scroller)

        self.body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        self.body.set_border_width(18)
        scroller.add(self.body)

        # One tick drives both the countdown and the automatic refresh; it lives as long as the
        # window does, so it returns True forever and is never removed.
        GLib.timeout_add_seconds(1, self._tick)
        self.refresh()

    # ── construction ───────────────────────────────────────────
    def _build_header(self):
        # The HeaderBar is the window's titlebar, so it only exists while the window is decorated —
        # i.e. in cards mode. The toolbar is undecorated, so its controls (the i button and the
        # one-line header) live in the body instead; they are created here, parentless, so
        # _set_subtitle and _toggle_mode keep stable references and _render_strip reparents them
        # into the bar.
        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        header.get_style_context().add_class('ai-header')
        self.set_titlebar(header)

        title_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        glyph = Gtk.Label(label='ai')
        glyph.set_size_request(30, 30)
        glyph.get_style_context().add_class('app-glyph')
        title_box.pack_start(glyph, False, False, 0)

        titles = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        title = Gtk.Label(label='AI Usage')
        title.set_xalign(0)
        title.get_style_context().add_class('win-title')
        self.subtitle = Gtk.Label(label='loading…')
        self.subtitle.set_xalign(0)
        self.subtitle.get_style_context().add_class('win-sub')
        titles.pack_start(title, False, False, 0)
        titles.pack_start(self.subtitle, False, False, 0)
        self.titles = titles
        title_box.pack_start(titles, False, False, 0)

        header.set_custom_title(None)
        header.pack_start(title_box)

        self.refresh_btn = Gtk.Button.new_with_label('↻ Refresh')
        self.refresh_btn.get_style_context().add_class('refresh')
        self.refresh_btn.connect('clicked', lambda _b: self.refresh())
        header.pack_end(self.refresh_btn)

        self.mode_btn = Gtk.Button()
        self.mode_btn.get_style_context().add_class('refresh')
        self.mode_btn.connect('clicked', lambda _b: self._toggle_mode())
        header.pack_end(self.mode_btn)

        self.oneline_label = Gtk.Label(label='')
        self.oneline_label.set_xalign(0)
        self.oneline_label.get_style_context().add_class('oneline')
        self.cards_btn = Gtk.Button.new_with_label('i')
        self.cards_btn.get_style_context().add_class('info')
        self.cards_btn.set_tooltip_text('Open the card view')
        self.cards_btn.connect('clicked', lambda _b: self._toggle_mode())
        self._update_mode_button()

    def _badge(self, klass):
        if klass not in ('low', 'mid', 'high', 'critical'):
            klass = 'unknown'
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        box.set_valign(Gtk.Align.CENTER)
        ctx = box.get_style_context()
        ctx.add_class('badge')
        ctx.add_class(klass)
        dot = Gtk.Box()
        dot.set_size_request(7, 7)
        dot.set_valign(Gtk.Align.CENTER)
        for c in ('dot', klass):
            dot.get_style_context().add_class(c)
        box.pack_start(dot, False, False, 0)
        box.pack_start(Gtk.Label(label=klass.upper()), False, False, 0)
        return box

    def _cells(self, pct):
        klass = klass_of(pct)
        on = round(max(0, min(100, pct)) / 5)
        # 1 cell = 5%: without this, 2.2% usage lights up zero cells and the card looks broken.
        # Used ≠ not used, so any positive usage lights up at least one.
        if pct > 0:
            on = max(on, 1)
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=3)
        row.set_homogeneous(True)
        for i in range(20):
            cell = Gtk.Box()
            ctx = cell.get_style_context()
            ctx.add_class('cell')
            if i < on:
                ctx.add_class('tip' if i == on - 1 else 'on')
                ctx.add_class(klass)
            row.pack_start(cell, True, True, 0)
        return row

    def _meter_row(self, meter):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)

        name = Gtk.Label(label=meter['name'])
        name.set_xalign(0)
        name.get_style_context().add_class('meter-name')
        top.pack_start(name, False, False, 0)

        if meter['trend']:
            trend = Gtk.Label(label=meter['trend'])
            trend.get_style_context().add_class('meter-trend')
            top.pack_start(trend, False, False, 0)

        # A balance has no reset time; money vendors carry a `note` ("$9.86 left") in its place.
        trailing = Gtk.Label(label=meter.get('note') or f"⟳ {meter['reset'] or '—'}")
        trailing.get_style_context().add_class('meter-reset')
        top.pack_end(trailing, False, False, 0)

        val = Gtk.Label(label=f"{fmt_pct(meter['pct'])}%")
        val.get_style_context().add_class('meter-val')
        top.pack_end(val, False, False, 0)

        box.pack_start(top, False, False, 0)
        box.pack_start(self._cells(meter['pct']), False, False, 0)
        return box

    def make_card(self, label, data):
        # A vendor read straight from the API already delivers `info` ready-made; the others come
        # from ai-usagebar's tooltip.
        info = data.get('info') or parse_tooltip(data.get('tooltip', ''), label)
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        card.get_style_context().add_class('card')
        card.set_hexpand(True)

        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        vendor = Gtk.Label(label=label)
        vendor.get_style_context().add_class('vendor')
        head.pack_start(vendor, False, False, 0)
        if info['plan']:
            pill = Gtk.Label(label=info['plan'])
            pill.set_valign(Gtk.Align.CENTER)
            pill.get_style_context().add_class('pill')
            head.pack_start(pill, False, False, 0)
        head.pack_end(self._badge(data.get('class', '?')), False, False, 0)
        card.pack_start(head, False, False, 0)

        if info['meters']:
            first = info['meters'][0]
            hero = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            num = Gtk.Label()
            # The decimal place goes together with the "%", in the smaller body: the decimal point in 38px
            # monospace opens a gap that looks like a rendering glitch ("2 . 8"). Big integer, small rest.
            integer, _, decimal = fmt_pct(first['pct']).partition('.')
            suffix = f'.{decimal}%' if decimal else '%'
            num.set_markup(f"<span size='31000' weight='bold'>{integer}</span>"
                           f"<span size='18000' weight='bold' foreground='#8b93a7'>{suffix}</span>")
            num.get_style_context().add_class('hero-num')
            num.set_valign(Gtk.Align.BASELINE)
            hero.pack_start(num, False, False, 0)

            ctx_lbl = Gtk.Label()
            # same split as the meter row: money says what is left, time says when it resets
            tail = (esc(first['note']) if first.get('note')
                    else f"resets in <span foreground='#e9ecf2' weight='bold'>"
                         f"{esc(first['reset'] or '—')}</span>")
            ctx_lbl.set_markup(f"{esc(first['name'])} · {tail}")
            ctx_lbl.get_style_context().add_class('hero-ctx')
            ctx_lbl.set_valign(Gtk.Align.BASELINE)
            hero.pack_start(ctx_lbl, False, False, 0)
            card.pack_start(hero, False, False, 0)

            meters = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
            for meter in info['meters']:
                meters.pack_start(self._meter_row(meter), False, False, 0)
            card.pack_start(meters, False, False, 0)
        else:
            # redacted like every other tooltip-derived label: this is the one that shows
            # when a vendor has no meters, which is exactly the degraded path
            fallback = Gtk.Label(label=redact_keys(data.get('text', 'no data')))
            fallback.set_xalign(0)
            fallback.get_style_context().add_class('hero-ctx')
            card.pack_start(fallback, False, False, 0)

        if info['extras']:
            foot = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
            foot.get_style_context().add_class('card-foot')
            foot_lbl = Gtk.Label(label=' · '.join(info['extras'][:4]))
            foot_lbl.set_xalign(0)
            foot_lbl.set_ellipsize(Pango.EllipsizeMode.END)
            foot.pack_start(foot_lbl, True, True, 0)
            card.pack_start(foot, False, False, 0)
        return card

    def draggable_card(self, vendor, label, data):
        wrapper = Gtk.EventBox()
        wrapper.set_visible_window(False)
        wrapper.vendor_id = vendor
        wrapper.add(self.make_card(label, data))
        wrapper.set_tooltip_text('Drag to reorder')
        targets = [Gtk.TargetEntry.new('application/x-ai-usage-card',
                                       Gtk.TargetFlags.SAME_APP, 0)]
        wrapper.drag_source_set(Gdk.ModifierType.BUTTON1_MASK, targets, Gdk.DragAction.MOVE)
        wrapper.drag_dest_set(Gtk.DestDefaults.MOTION | Gtk.DestDefaults.HIGHLIGHT,
                              targets, Gdk.DragAction.MOVE)
        wrapper.connect('drag-drop', self._drop_card)
        return wrapper

    def _drop_card(self, target, context, _x, _y, timestamp):
        source = Gtk.drag_get_source_widget(context)
        valid = (source is not None and hasattr(source, 'vendor_id')
                 and source.get_parent() == self.card_grid
                 and target.get_parent() == self.card_grid)
        if valid:
            self.move_card(source.vendor_id, target.vendor_id)
        Gtk.drag_finish(context, valid, False, timestamp)
        return True

    def move_card(self, source, target):
        cards = {card.vendor_id: card for card in self.card_grid.get_children()}
        if source == target or source not in cards or target not in cards:
            return
        visible = [vendor for vendor in self.card_order if vendor in cards]
        destination = visible.index(target)
        visible.remove(source)
        visible.insert(destination, source)
        # Keep offline vendors in their slots so a later refresh can restore them.
        ordered = iter(visible)
        self.card_order = [next(ordered) if vendor in cards else vendor
                           for vendor in self.card_order]
        for i, vendor in enumerate(visible):
            self.card_grid.child_set_property(cards[vendor], 'left-attach', i % 2)
            self.card_grid.child_set_property(cards[vendor], 'top-attach', i // 2)
        save_card_order(self.card_order)

    def make_offline_row(self, vendor, label, data):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        row.get_style_context().add_class('off-row')

        dot = Gtk.Box()
        dot.set_size_request(7, 7)
        dot.set_valign(Gtk.Align.CENTER)
        for c in ('dot', 'unknown'):
            dot.get_style_context().add_class(c)
        row.pack_start(dot, False, False, 0)

        name = Gtk.Label(label=label)
        name.set_xalign(0)
        name.set_size_request(96, -1)
        name.get_style_context().add_class('off-name')
        row.pack_start(name, False, False, 0)

        why_text, fix_text = offline_reason(vendor, data)
        why = Gtk.Label(label=why_text)
        why.set_xalign(0)
        why.set_ellipsize(Pango.EllipsizeMode.END)
        why.get_style_context().add_class('off-why')
        row.pack_start(why, True, True, 0)

        fix = Gtk.Label(label=fix_text)
        fix.set_valign(Gtk.Align.CENTER)
        fix.get_style_context().add_class('off-fix')
        row.pack_end(fix, False, False, 0)
        return row

    def _section_label(self, text, count):
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        lbl = Gtk.Label(label=text.upper())
        lbl.get_style_context().add_class('section-label')
        box.pack_start(lbl, False, False, 0)
        cnt = Gtk.Label(label=str(count))
        cnt.get_style_context().add_class('section-count')
        box.pack_start(cnt, False, False, 0)
        rule = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
        rule.set_valign(Gtk.Align.CENTER)
        rule.get_style_context().add_class('section-rule')
        box.pack_start(rule, True, True, 0)
        return box

    # ── data ───────────────────────────────────────────────────
    def refresh(self):
        self._refreshing = True
        self.refresh_btn.set_sensitive(False)
        self._set_subtitle('updating…')

        def worker():
            entries = vendor_entries()
            with ThreadPoolExecutor(max_workers=len(entries)) as pool:
                results = list(pool.map(lambda v: (v[0], v[1], run_vendor(v[0])), entries))
            GLib.idle_add(self.render, results)

        threading.Thread(target=worker, daemon=True).start()

    def _set_subtitle(self, text):
        """One place that owns the subtitle text. The toolbar's single line mirrors it
        unconditionally, so `updating…`, the stamp and the per-second countdown all reach both
        layouts regardless of which is currently visible."""
        self.subtitle.set_text(text)
        self.oneline_label.set_text(f'AI Usage · {text}')

    def _tick(self):
        """Once a second: repaint the countdown, and refresh when it reaches zero.

        A cycle already in flight is left alone — the subtitle reads `updating…` and repainting a
        countdown over it would show time remaining on a read that has not finished, while firing a
        second refresh would stack requests on vendors whose timeouts run to 30s.
        """
        if self._refreshing or self._next_refresh is None:
            return True
        remaining = self._next_refresh - time.monotonic()
        if remaining <= 0:
            self.refresh()
        else:
            self._paint_countdown(remaining)
        return True

    def _paint_countdown(self, remaining):
        # Empty base means the first render has not landed yet; the label still says `loading…`
        # and a countdown appended to it would be noise about a cycle nobody has seen.
        if self._subtitle_base:
            self._set_subtitle(f'{self._subtitle_base} · {fmt_countdown(remaining)}')

    def _primary_geometry(self):
        display = Gdk.Display.get_default()
        monitor = display.get_primary_monitor() or display.get_monitor(0)
        return monitor.get_geometry() if monitor else None

    def _toolbar_span(self):
        """(x, width, bottom) for the toolbar. The bottom edge: at the top the bar sat under
        GNOME's panel. x and width come from the work area, which keeps it clear of the dock on the
        left; the bottom comes from the MONITOR, because the work area shrinks by the bar's own
        strut and would push it up by its height on every toggle."""
        geo, area = self._primary_geometry(), self._primary_workarea()
        if geo is None or area is None:
            return 0, 1280, 800
        return area.x, area.width, geo.y + geo.height

    def _reserve_strip(self):
        """Toolbar only: ask the WM to keep maximized windows out of the bar's strip — without it
        the bar covered the bottom of maximized windows, e.g. Discord's message box."""
        if self.mode != 'toolbar':
            return
        x, width, bottom = self._toolbar_span()
        root_height = self.get_screen().get_root_window().get_height()
        write_strut(self.get_window(), bottom_strut(root_height, x, width, bottom, TOOLBAR_HEIGHT))

    def _primary_workarea(self):
        """The primary monitor minus what the shell reserves: GNOME's top panel, the Ubuntu dock."""
        display = Gdk.Display.get_default()
        monitor = display.get_primary_monitor() or display.get_monitor(0)
        return monitor.get_workarea() if monitor else None

    def _apply_presentation(self):
        """One place that makes the window look like its mode: the toolbar is undecorated,
        keep-above and pinned to the bottom edge of the primary monitor's work area, at its full
        width; cards is a decorated,
        centered, tall window. It only takes full effect on a window that is not realized yet —
        _toggle_mode unmaps and unrealizes before calling it, so each switch is a fresh start."""
        geo = self._primary_geometry()
        if self.mode == 'toolbar':
            # DOCK makes the WM treat the bar as a panel: no decoration, no maximize, stays where it
            # is placed. A plain borderless window as wide as the screen gets maximized by mutter
            # (the bug seen on GNOME: the bar filled the screen with its body below).
            self.set_type_hint(Gdk.WindowTypeHint.DOCK)
            self.set_decorated(False)
            self.set_keep_above(True)
            self.unmaximize()
            x, width, bottom = self._toolbar_span()
            self.move(x, bottom - TOOLBAR_HEIGHT)
            self.resize(width, TOOLBAR_HEIGHT)
        else:
            self.set_type_hint(Gdk.WindowTypeHint.NORMAL)
            self.unmaximize()
            self.set_decorated(True)
            self.set_keep_above(False)
            self.set_position(Gtk.WindowPosition.CENTER)
            screen_h = geo.height if geo else 800
            self.resize(940, min(1400, max(640, screen_h - 80)))

    def _update_mode_button(self):
        # Visibility is structural, not toggled: cards shows the HeaderBar (titles + mode_btn +
        # Refresh), the toolbar shows the body bar (i button + one-line header + blocks). Only the
        # label and the one-line text need updating here.
        if self.mode == 'toolbar':
            # Sync the one-line header with whatever the subtitle currently says, so entering the
            # toolbar mid-collection shows `updating…` instead of stale or empty text.
            self.oneline_label.set_text(f'AI Usage · {self.subtitle.get_text()}')
            self.mode_btn.set_label('▦ Cards')
            self.mode_btn.set_tooltip_text('Switch to the card grid')
        else:
            self.mode_btn.set_label('📌 Toolbar')
            self.mode_btn.set_tooltip_text('Pin as an always-on-top toolbar')

    def _toggle_mode(self):
        """Visual-only switch: flip the mode, persist it, re-present the window, and rebuild from
        the cached results. It deliberately touches neither the countdown/_next_refresh nor the
        in-flight state, so alternating presentations never postpones the next refresh or ends a
        collection early."""
        self.mode = 'toolbar' if self.mode == 'cards' else 'cards'
        save_mode(self.mode)
        self._update_mode_button()
        # The compositor only honours the DOCK hint, the undecorated frame and the top-edge
        # placement when a window is MAPPED with them; changing them on a window already on screen
        # was ignored (Wayland: the bar kept the cards' position and came out 46px tall, clipping
        # its lines; X11: mutter kept it a normal 1238x1020 window). Unmapping first makes every
        # switch look like a fresh start in that mode.
        mapped = self.get_mapped()
        if mapped:
            self.hide()
        # Unrealizing too drops the GdkWindow, so the next show() creates it from scratch, exactly
        # as at startup. Re-presenting a still-realized window made GTK3 add the old client-side
        # frame (shadow + titlebar) to the new size: the toolbar came back 46px tall.
        self.unrealize()
        self._apply_presentation()
        # Before the first collection lands there is nothing to rebuild; render() will do it.
        if self._last_results is not None:
            self._rebuild(self._last_results)
        if mapped:
            self.show()

    def render(self, results):
        """Collection COMPLETED. The only place that updates the subtitle, re-arms the countdown,
        clears the in-flight flag and re-enables Refresh — then delegates the body to _rebuild."""
        self._last_results = results
        goods = [(v, l, d) for v, l, d in results if not is_bad(d)]
        updated = ''
        for _v, _l, data in goods:
            info = data.get('info') or parse_tooltip(data.get('tooltip', ''), _l)
            updated = info['updated'] or updated
        parts = [f'{len(results)} vendors']
        if updated:
            parts.insert(0, f'updated at {updated}')
        self._subtitle_base = ' · '.join(parts)
        # Armed here, on completion: the manual ↻ Refresh ends in this same method, so it rearms
        # the countdown by itself and is never followed one second later by an automatic cycle.
        self._next_refresh = time.monotonic() + self.auto_refresh
        self._refreshing = False
        self._paint_countdown(self.auto_refresh)
        self.refresh_btn.set_sensitive(True)
        self._rebuild(results)
        return False

    def _rebuild(self, results):
        """Reconstruct the body for the current mode. Classification and ordering live HERE so
        render() and a mode toggle share one contract; no completion effects (subtitle, timer,
        in-flight flag, Refresh button) belong here. Shared body properties are set in BOTH
        branches, so cards→strip→cards restores the card layout."""
        # The i button and the single line outlive every bar they are reparented into. Detach them
        # BEFORE the old bar goes: a GtkContainer that is dropped destroys the children still inside
        # it, and a destroyed button loses its 'clicked' handler — on the second cards→toolbar trip
        # the button did nothing. Our own reference keeps them alive while they have no parent.
        for widget in (self.cards_btn, self.oneline_label):
            parent = widget.get_parent()
            if parent is not None:
                parent.remove(widget)
        for child in self.body.get_children():
            self.body.remove(child)

        goods = [(v, l, d) for v, l, d in results if not is_bad(d)]
        bads = [(v, l, d) for v, l, d in results if is_bad(d)]
        for vendor, _label, _data in results:
            if vendor not in self.card_order:
                self.card_order.append(vendor)
        goods.sort(key=lambda item: self.card_order.index(item[0]))

        if self.mode == 'toolbar':
            self.body.set_border_width(2)
            self.body.set_spacing(0)
            self._render_strip(goods)
        else:
            self.body.set_border_width(18)
            self.body.set_spacing(18)
            grid = self.card_grid = Gtk.Grid()
            grid.set_row_spacing(14)
            grid.set_column_spacing(14)
            grid.set_column_homogeneous(True)
            for i, (vendor, label, data) in enumerate(goods):
                grid.attach(self.draggable_card(vendor, label, data), i % 2, i // 2, 1, 1)
            self.body.pack_start(grid, False, False, 0)
            if bads:
                self.body.pack_start(self._section_label('Not configured', len(bads)), False, False, 0)
                off_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
                for vendor, label, data in bads:
                    off_box.pack_start(self.make_offline_row(vendor, label, data), False, False, 0)
                self.body.pack_start(off_box, False, False, 0)
        self.body.show_all()

    @staticmethod
    def _reparent(widget, box):
        parent = widget.get_parent()
        if parent is not None:
            parent.remove(widget)
        box.pack_start(widget, False, False, 0)

    def _render_strip(self, goods):
        """The toolbar body: one horizontal bar with the i button, the glyph, the one-line header
        and one compact block per configured vendor — no "Not configured" section. The i button
        and the one-line label live here (not in the HeaderBar) because an undecorated window has
        no titlebar. ai-usagebar vendors carry no `info`; their windows come from the tooltip,
        the same fallback the card uses — without it Claude/Codex would render empty."""
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        bar.get_style_context().add_class('strip')
        bar.get_style_context().add_class('toolbar')
        bar.set_border_width(2)

        self._reparent(self.cards_btn, bar)
        glyph = Gtk.Label(label='ai')
        glyph.get_style_context().add_class('app-glyph')
        bar.pack_start(glyph, False, False, 0)
        self._reparent(self.oneline_label, bar)
        bar.pack_start(Gtk.Separator(orientation=Gtk.Orientation.VERTICAL), False, False, 4)

        for vendor, label, data in goods:
            block = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            block.get_style_context().add_class('block')

            top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
            name = Gtk.Label(label=label)
            name.set_xalign(0)
            name.get_style_context().add_class('vname')
            top.pack_start(name, False, False, 0)
            block.pack_start(top, False, False, 0)

            info = data.get('info') or parse_tooltip(data.get('tooltip', ''), label)
            window, weekly = pick_strip_meters(info)
            for meter in (window, weekly):
                if meter is None:
                    continue
                # One status dot per meter line, not per vendor: each meter has its own usage, so
                # a single vendor color would hide e.g. a calm session next to a 92% weekly.
                pct = meter.get('pct')
                row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
                # A ● glyph, not a painted shape: an empty Label reserves a text line's height
                # (18px) and turns a background dot into a vertical pill, DrawingArea/Box paint no
                # CSS background in this GTK3 build, and a cairo draw handler needs python3-gi-cairo,
                # which this box lacks. The glyph is round by definition and colored via CSS.
                dot = Gtk.Label(label='●')
                dot.set_valign(Gtk.Align.CENTER)
                dot.get_style_context().add_class('mdot')
                dot.get_style_context().add_class(klass_of(pct) if pct is not None else 'unknown')
                row.pack_start(dot, False, False, 0)
                line = Gtk.Label(label=fmt_meter_line(meter))
                line.set_xalign(0)
                line.get_style_context().add_class('vline')
                row.pack_start(line, False, False, 0)
                block.pack_start(row, False, False, 0)

            bar.pack_start(block, False, False, 0)
        self.body.pack_start(bar, False, False, 0)


