# API `unit` → (seconds per unit, label, label when number == 1). Confirmed from the resets on
# 2026-09-04: unit 3 reset in ~4h (5-hour window) and unit 6 in 7 days (weekly).
# The seconds exist to SORT by duration: sorting by reset time looks equivalent and isn't — in the
# hours before the weekly reset, the weekly window resets before the 5h one and would steal the
# hero number, hiding exactly the window that's throttling usage.
ZAI_UNITS = {
    3: (3600, 'Session {n}h', 'Session 1h'),
    6: (604800, '{n} weeks', 'Weekly'),
}

# Usage ranges → color class (green → amber → orange → red)
def klass_of(pct):
    if pct < 40:
        return 'low'
    if pct < 70:
        return 'mid'
    if pct < 90:
        return 'high'
    return 'critical'


