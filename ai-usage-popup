# Faixas de uso → classe de cor (verde → âmbar → laranja → vermelho)
def klass_of(pct):
    if pct < 40:
        return 'low'
    if pct < 70:
        return 'mid'
    if pct < 90:
        return 'high'
    return 'critical'


