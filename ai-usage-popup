def strip_markup(text: str) -> str:
    """Remove spans/tags and the tooltip frame, preserving the bars."""
    text = re.sub(r"<[^>]+>", "", text)
    for ch in "╭╮╰╯":
        text = text.replace(ch, "")
    text = text.replace("│", " ")
    text = re.sub(r"─{2,}", "", text)
    # icon glyphs (nerd fonts / PUA) and clock
    text = re.sub(r"[-\U000f0000-\U000fffff⏱]", "", text)
    lines = []
    for line in text.splitlines():
        line = " ".join(line.split()).strip()
        if line:
            lines.append(line)
    return "\n".join(lines)


def parse_tooltip(tooltip: str, vendor_label: str):
    """Extract plan, meters (name, %, trend, reset), extras and timestamp."""
    lines = strip_markup(tooltip).splitlines()
    info = {'plan': '', 'meters': [], 'extras': [], 'updated': ''}
    if lines:
        title = lines[0]
        info['plan'] = title[len(vendor_label):].strip() if title.startswith(vendor_label) else title

    prev_label = ''
    for line in lines[1:]:
        m_up = re.search(r"Updated\s+(\S+)", line)
        if m_up:
            info['updated'] = m_up.group(1)
            continue
        m_reset = re.search(r"Resets in\s+(.+)", line)
        if m_reset:
            if info['meters']:
                info['meters'][-1]['reset'] = m_reset.group(1).strip()
            continue
        is_bar = '%' in line and ('█' in line or '░' in line)
        if is_bar:
            m_pct = re.search(r"(\d+)%", line)
            if m_pct:
                info['meters'].append({
                    'name': prev_label or f'Usage {len(info["meters"]) + 1}',
                    'pct': int(m_pct.group(1)),
                    'trend': '↓' if '↓' in line else ('↑' if '↑' in line else ''),
                    'reset': '',
                })
            prev_label = ''
            continue
        if '█' in line or '░' in line:
            continue
        prev_label = line

    # stray lines (credits etc.) become the footer; the pending label goes along
    for line in lines[1:]:
        if re.search(r"balance:|messages", line):
            if 'Credits' not in info['extras'] and any('Credits' in l for l in lines):
                info['extras'].append('Credits')
            info['extras'].append(line)
    return info


# OpenRouter reports money, not time windows: "$0.14 of $10.00 used (1%)" for the balance and
# "$49.86 of $50.00 remaining" for the per-key cap. Note the two phrasings mean opposite things,
# and that the amount may be negative on an overdrawn account.
OPENROUTER_MONEY = re.compile(r'\$(-?[\d,.]+)\s+of\s+\$(-?[\d,.]+)\s+(used|remaining)')


API_KEY_FRAGMENT = re.compile(r'\bsk-[A-Za-z0-9._-]{2,}')
TIER_WORD = re.compile(r'\btier\b', re.IGNORECASE)


def redact_keys(text):
    """Blank out anything shaped like an API key before it can reach the screen.

    Skipping the tooltip's first line is a POSITIONAL guard: it holds only while the vendor keeps
    the key on that exact line. This is the guard by content, so one extra line from the binary
    cannot put the key back on a card.
    """
    return API_KEY_FRAGMENT.sub('sk-…', text)


def openrouter_tier(tooltip):
    """The plan pill for OpenRouter: the tier line, never the tooltip title.

    The title is "OpenRouter — sk-or-v1-...", so reading it — which is what parse_tooltip() does
    for every other vendor — would print a fragment of the API key on the card.
    """
    for line in strip_markup(tooltip).splitlines()[1:]:
        # whole word: "frontier models" is OpenRouter's own vocabulary and must not pass as a tier
        if TIER_WORD.search(line):
            return redact_keys(line.strip())
    return ''


def openrouter_blank(tooltip):
    """Info with no meters, for when the tooltip cannot be parsed.

    It exists so the card never falls back to parse_tooltip() for this vendor: that fallback
    would put the key fragment back in the plan pill.
    """
    return {'plan': openrouter_tier(tooltip), 'meters': [], 'extras': [], 'updated': ''}


def openrouter_info(tooltip):
    """Build the card info for OpenRouter, which has balances instead of windows that reset.

    Returns None when the tooltip carries no usable money line, so the caller can degrade to
    openrouter_blank() — losing detail is fine, inventing a number is not.
    """
    lines = strip_markup(tooltip).splitlines()
    rows, extras, updated, pending = [], [], '', ''

    # lines[0] is "OpenRouter — sk-or-v1-...", which carries a fragment of the API key: never read it
    for line in lines[1:]:
        m_updated = re.search(r'Updated\s+(\S+)', line)
        if m_updated:
            updated = redact_keys(m_updated.group(1))
            continue
        if TIER_WORD.search(line):
            continue
        m_money = OPENROUTER_MONEY.search(line)
        if m_money:
            # per line, so one unreadable figure costs its own meter and not the whole card:
            # aborting the function would throw away the meters that parsed perfectly well
            try:
                total = float(m_money.group(2).replace(',', ''))
                amount = float(m_money.group(1).replace(',', ''))
            except ValueError:
                print(f'openrouter: unreadable money line: {line.strip()!r}', file=sys.stderr)
                pending = ''
                continue
            if total <= 0:
                pending = ''
                continue
            # "used" gives what was spent; "remaining" gives the opposite — reading one as the
            # other turns an untouched key into a nearly full red gauge
            used = amount if m_money.group(3) == 'used' else total - amount
            rows.append({
                'name': redact_keys(pending) or f'Usage {len(rows) + 1}',
                # from the dollars, not from the "(1%)" the tooltip rounds off. A credit can push
                # `used` below zero; a gauge cannot go backwards, so the bar floors at empty while
                # the note keeps the real figure.
                'pct': max(0.0, used / total * 100),
                'trend': '',
                'reset': '',
                'note': f'${total - used:,.2f} left',
            })
            pending = ''
            continue
        if re.search(r'today .*week .*month', line):
            extras.append(redact_keys(line.strip()))
            pending = ''
            continue
        if '█' in line or '░' in line:   # the bar sits between the label and its figures
            continue
        pending = line.strip()

    if not rows:
        return None
    # Most spent first, so the hero is the limit that actually binds — NOT the smallest pot, which
    # is a different thing: a $10 balance at 1% next to a $50 cap at 96% would headline the green
    # one and hide the limit about to block every request.
    rows.sort(key=lambda meter: meter['pct'], reverse=True)
    return {'plan': openrouter_tier(tooltip), 'meters': rows,
            'extras': extras, 'updated': updated}


def fmt_pct(value):
    """Percentage for display: one decimal below 10%, integer from there up.

    Below 10% the decimal place is informative — 0.4% and 2.2% would both become "2%" if rounded.
    Above that it just adds noise, and the other vendors have always shown an integer.
    """
    # round BEFORE deciding: 9.96 becomes "10.0" with one decimal, breaking the rule itself
    rounded = round(value, 1)
    if rounded >= 10 or rounded == int(rounded):
        return str(int(round(value)))
    return f'{rounded:.1f}'


def fmt_delta(ms_epoch):
    """Time left until `ms_epoch` (milliseconds), in the same style as the other cards: `2d 17h`, `4h 31m`."""
    if not isinstance(ms_epoch, (int, float)) or isinstance(ms_epoch, bool):
        return '—'
    secs = int(ms_epoch / 1000 - time.time())
    if secs <= 0:
        return 'now'
    days, rest = divmod(secs, 86400)
    hours, rest = divmod(rest, 3600)
    minutes = rest // 60
    if days:
        return f'{days}d {hours}h'
    if hours:
        return f'{hours}h {minutes}m'
    return f'{minutes}m'


def zai_api_key():
    """Z.AI key: ai-usagebar's config.toml first, the env afterwards.

    Same source ai-usagebar uses — no third place to keep updated. The config.toml serves the
    popup launched from the .desktop file, which doesn't see what .bashrc exports.
    """
    try:
        with ZAI_CONFIG.open('rb') as fh:
            section = tomllib.load(fh).get('zai')
        # `zai = "key"` instead of `[zai]` is a plausible typo: it can't turn into an exception
        key = section.get('api_key', '') if isinstance(section, dict) else ''
        if key:
            return key
    except (OSError, tomllib.TOMLDecodeError):
        pass
    return os.environ.get('ZAI_API_KEY', '')


def zai_window_label(limit):
    """Meter label from unit/number.

    An unknown unit returns a degraded label instead of disappearing: a new plan changing `unit`
    can't turn into a silently empty card.
    """
    unit = limit.get('unit')
    number = limit.get('number', 0)
    if unit in ZAI_UNITS:
        _, plural, singular = ZAI_UNITS[unit]
        return singular if number == 1 else plural.format(n=number)
    return f'Window {number}·u{unit}'


def zai_window_seconds(limit):
    """Window duration in seconds — the sort key.

    An unknown unit goes to the end instead of competing for the hero number with a made-up duration.
    """
    unit = limit.get('unit')
    number = limit.get('number', 0)
    if unit in ZAI_UNITS and isinstance(number, (int, float)):
        return ZAI_UNITS[unit][0] * number
    return float('inf')


def zai_error(reason):
    """Single error contract for Z.AI — the same for all five failure classes.

    `text` is what is_bad() recognizes, so no failure turns into a card with a fake number; `reason`
    and `fix` are read by offline_reason() for the "not configured" line.
    """
    return {'text': 'unavailable', 'tooltip': reason, 'class': 'critical',
            'reason': reason, 'fix': '[zai] api_key'}


def zai_info(payload):
    """Translate the Z.AI API response into the format parse_tooltip() produces. Pure function."""
    if not isinstance(payload, dict):
        raise ValueError('response is not a JSON object')
    if not payload.get('success'):
        raise ValueError(f"API refused: {payload.get('msg') or 'no reason given'}")
    # every check comes BEFORE the access it protects: validating after using protects nothing
    data = payload.get('data') or {}
    if not isinstance(data, dict):
        raise ValueError('response has no usage windows')
    limits = data.get('limits') or []
    if not isinstance(limits, list) or not limits:
        raise ValueError('response has no usage windows')
    # before the sorted(): the sort key already accesses each window
    if not all(isinstance(limit, dict) for limit in limits):
        raise ValueError('malformed usage window')

    meters, credits = [], []
    # sorts by window DURATION, not by reset time — see the comment on ZAI_UNITS
    for limit in sorted(limits, key=zai_window_seconds):
        used, total = limit.get('currentValue'), limit.get('usage')
        # a missing field must NOT become 0% green: that's exactly the fake number the card can't show
        if used is None or total is None:
            raise ValueError('response is missing usage fields')
        used, total = float(used), float(total)
        if total <= 0:
            raise ValueError('invalid window limit')
        label = zai_window_label(limit)
        meters.append({'name': label, 'pct': used / total * 100, 'trend': '',
                       'reset': fmt_delta(limit.get('nextResetTime'))})
        credits.append(f'{used:.0f}/{total:.0f} ({label.lower()})')

    level = data.get('level') or ''
    return {'plan': f'GLM Coding {level.capitalize()}' if level else '',
            'meters': meters,
            'extras': [f"credits {' · '.join(credits)}"] if credits else [],
            # empty on purpose: the global subtitle shows "the last non-empty one", and stamping the
            # local clock here would make another vendor's stale cache look just-read
            'updated': ''}


def run_zai():
    """Reads Z.AI usage directly from the API, bypassing ai-usagebar."""
    key = zai_api_key()
    if not key:
        return zai_error('no API key')

    req = urllib.request.Request(ZAI_URL, headers={'Authorization': f'Bearer {key}'})
    try:
        with urllib.request.urlopen(req, timeout=ZAI_TIMEOUT) as resp:
            body = resp.read()
    except urllib.error.HTTPError as e:          # subclass of URLError: comes first
        return zai_error(f'HTTP {e.code}')
    except TimeoutError:
        return zai_error(f'timed out ({ZAI_TIMEOUT}s)')
    except urllib.error.URLError as e:
        reason = getattr(e, 'reason', '')
        if isinstance(reason, TimeoutError) or 'timed out' in str(reason).lower():
            return zai_error(f'timed out ({ZAI_TIMEOUT}s)')
        return zai_error('network unavailable')    # DNS, connection refused: different diagnosis
    except OSError:
        return zai_error('network unavailable')

    try:
        payload = json.loads(body)
    except (ValueError, UnicodeDecodeError):
        return zai_error('response is not JSON')

    try:
        info = zai_info(payload)
    except ValueError as e:
        return zai_error(str(e))

    first = info['meters'][0]
    return {'text': f"{fmt_pct(first['pct'])}%", 'tooltip': '',
            'class': klass_of(first['pct']), 'info': info}


def run_vendor(vendor: str):
    if vendor == 'zai':
        # The generic guard is mandatory here: this detour happens OUTSIDE the try below, and an
        # exception escaping kills the pool thread — GLib.idle_add(render) never runs and the whole
        # popup freezes on "updating…", taking the other five vendors down with it.
        try:
            return run_zai()
        except Exception as e:
            return zai_error(f'unexpected failure: {type(e).__name__}')
    try:
        out = subprocess.check_output([AI, '--vendor', vendor, '--json'],
                                      text=True, stderr=subprocess.DEVNULL, timeout=20)
        data = json.loads(out)
        result = {
            'text': strip_markup(str(data.get('text', ''))),
            'tooltip': str(data.get('tooltip', '')),
            'class': data.get('class', '?'),
        }
        if vendor == 'openrouter':
            # A parser failure here must cost detail, not the vendor: without the guard the
            # exception would reach the except below and report a working account as unavailable.
            # `info` is attached even when empty, ON PURPOSE: letting make_card fall back to
            # parse_tooltip() would read the tooltip title — and the API key fragment in it — as
            # the plan pill, which is exactly what this vendor's card must never show.
            # openrouter_blank() is inside the guard too: it re-reads the same tooltip, so
            # whatever broke the parser can break it as well, and the outer except would then
            # report a working account as unavailable.
            try:
                result['info'] = openrouter_info(result['tooltip']) or \
                    openrouter_blank(result['tooltip'])
            except Exception as e:
                # say it out loud: the silent symptom is the card quietly losing its gauges
                print(f'openrouter: could not read the tooltip ({type(e).__name__}: {e})',
                      file=sys.stderr)
                result['info'] = {'plan': '', 'meters': [], 'extras': [], 'updated': ''}
        return result
    except Exception as e:
        return {'text': 'unavailable', 'tooltip': str(e), 'class': 'critical'}


def is_bad(data):
    txt = (data.get('text') or '').lower()
    tip = strip_markup(data.get('tooltip') or '').lower()
    return ('no api key' in tip or 'no usable cache' in tip or 'credentials error' in tip
            or txt in ('⚠', 'unavailable'))


def offline_reason(vendor, data):
    # A vendor read straight from the API already brings reason and fix ready to use (zai_error's
    # contract). Without this branch, a timeout would fall into the generic `config.toml` fallback
    # with the raw error text.
    if data.get('reason'):
        return data['reason'], data.get('fix') or 'config.toml'
    tip = strip_markup(data.get('tooltip') or '').lower()
    if 'no usable cache' in tip:
        return 'no cache yet — run the vendor once to fill it', f'ai-usagebar --vendor {vendor}'
    if 'no api key' in tip or 'credentials error' in tip:
        return 'no API key', f'[{vendor}] api_key'
    first = strip_markup(data.get('tooltip') or data.get('text') or 'unavailable').splitlines()
    # This renders the tooltip's FIRST line, which for OpenRouter is "OpenRouter — sk-or-v1-…".
    # make_card was hardened against that; this is the sibling renderer, and it reaches the screen
    # through the "not configured" row.
    return redact_keys(first[0] if first else 'unavailable'), 'config.toml'


def esc(text):
    return GLib.markup_escape_text(str(text))


class UsageWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title='AI Usage')
        self.set_default_size(940, 640)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name('ai-usage-popup')
        self.get_style_context().add_class('ai-window')

        Gtk.Settings.get_default().set_property('gtk-application-prefer-dark-theme', True)
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self._build_header()

        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.add(scroller)

        self.body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        self.body.set_border_width(18)
        scroller.add(self.body)

        self.refresh()

    # ── construction ───────────────────────────────────────────
    def _build_header(self):
        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        header.get_style_context().add_class('ai-header')
        self.set_titlebar(header)

        title_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        glyph = Gtk.Label(label='ai')
        glyph.set_size_request(30, 30)
        glyph.get_style_context().add_class('app-glyph')
        title_box.pack_start(glyph, False, False, 0)

        titles = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        title = Gtk.Label(label='AI Usage')
        title.set_xalign(0)
        title.get_style_context().add_class('win-title')
        self.subtitle = Gtk.Label(label='loading…')
        self.subtitle.set_xalign(0)
        self.subtitle.get_style_context().add_class('win-sub')
        titles.pack_start(title, False, False, 0)
        titles.pack_start(self.subtitle, False, False, 0)
